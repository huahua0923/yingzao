  "pipeline": [
    {
      "id": "dwg2dxf",
      "no": 0,
      "label": "DWG → DXF",
      "scope": "source",
      "script": "convert_dwg_to_dxf.py",
      "writes": true,
      "slow": true,
      "runnable": false,
      "produces": [],
      "upstream": null,
      "why_manual": "需要 ODA File Converter 桌面程序 + DWG 源目录，属一次性摄入。命令行：python -u convert_dwg_to_dxf.py --filter <名>（audit=1 是铁律，不开会漏实体）",
      "desc": "二进制 DWG 转成 ezdxf 可读的 DXF，是整个管线的地基"
    },
    {
      "id": "recognize",
      "no": 1,

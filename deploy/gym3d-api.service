[Unit]
Description=校园数字孪生平台 API (gym3d)
Documentation=https://github.com/huahua0923/yingzao
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=gym3d
Group=gym3d
WorkingDirectory=/opt/gym3d

# 所有可配的键都在这里（含 LIHUA_DB_*、GYM3D_COMPUTE、GYM3D_LOOPBACK_BREAKGLASS）
EnvironmentFile=/opt/gym3d/.env

# 判词全是中文；不加这两行会在打印时抛 UnicodeEncodeError（本仓铁律 168）
Environment=PYTHONIOENCODING=utf-8
Environment=PYTHONUNBUFFERED=1

# ★ 不带 --reload：run_api.py 只在显式传参时才开 reload，
#   而 reload 会起一个监视子进程，systemd 的 Restart 语义会变得不可预测。
ExecStart=/opt/gym3d/.venv/bin/python -u /opt/gym3d/backend/api/run_api.py

Restart=always
RestartSec=3

# ── 对外形态：用户 2026-10-01 定「不要域名，用 8141」⇒ 直挂 0.0.0.0:8141 ──
#
# ★ 这里**故意没有** IPAddressAllow / IPAddressDeny 两行 —— 它们原本是按
#   「nginx 反代到 127.0.0.1:8140」写的（IPAddressAllow=localhost + IPAddressDeny=any）。
#   形态改成直连之后，那两行会把**所有非回环的包**在内核里挡掉：服务 systemd 报 active、
#   本机 curl 健康检查也过，而**外面一台都连不上** —— 一个「看起来全绿」的半死状态。
#   直连形态下，进来的口子由两处把守：
#     ① firewall-cmd 只放行 8141/tcp（见部署记录）
#     ② 应用自己的 AuthGate（GYM3D_LOOPBACK_BREAKGLASS=0 + GYM3D_COMPUTE=0）
#   ★ 若哪天改回 nginx 反代，把这两行加回来（那时它们才是对的）：
#       IPAddressAllow=localhost
#       IPAddressDeny=any

# 加固：本服务只需要读 /opt/gym3d，写它的 data/
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/gym3d/data

StandardOutput=journal
StandardError=journal
SyslogIdentifier=gym3d-api

[Install]
WantedBy=multi-user.target

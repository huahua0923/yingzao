[Unit]
Description=cdut3d campus 3D service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cdut3d
Group=cdut3d
WorkingDirectory=/srv/cdut3d/current
EnvironmentFile=-/etc/cdut3d/cdut3d.env
Environment=PYTHONUTF8=1
Environment=PYTHONIOENCODING=utf-8
Environment=CDUT3D_MODE=viewer
ExecStart=/usr/bin/python3 -X utf8 -I workbench/server.py --host 127.0.0.1 --port 8150
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
ReadOnlyPaths=/srv/cdut3d/current

[Install]
WantedBy=multi-user.target


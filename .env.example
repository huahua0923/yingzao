# gym3d 配置模板 —— 复制成 .env 再填值。.env 已被 .gitignore 排除。
#
# 本文件是**唯一**的配置清单：代码里不出现盘符、端口、口令的字面量。
# 各字段的权威定义见 backend/api/settings.py（Phase 1 落地）。

# ── 路径 ─────────────────────────────────────────────────────────────
# GYM3D_ROOT=               # 留空 = 自动从 backend/api/settings.py 推导仓库根
# GYM3D_DATA_DIR=           # 留空 = <root>/data
GYM3D_DXF_DIR=              # 源 DXF 目录。**仅本机建模需要**；服务器留空
# GYM3D_FRONTEND_DIST=      # 留空 = <root>/frontend/dist

# ── 能力：决定本进程是全功能控制台还是只读服务器 ──────────────────────
# 1 = 本机（可跑管道、可改参数）   0 = 服务器（只发产物，写接口一律 403）
GYM3D_COMPUTE=1
# dev = 允许本地 CORS、返回错误详情；prod = 收紧
GYM3D_ENV=dev

# ── HTTP ────────────────────────────────────────────────────────────
GYM3D_HOST=127.0.0.1         # 服务器上保持 127.0.0.1，只给 nginx 反代，不直接对外
GYM3D_PORT=8140              # 新 API。刻意避开老控制台的 8130，Phase 2 才能双跑对拍
GYM3D_API_PREFIX=/api
GYM3D_CORS_ORIGINS=http://localhost:5173   # prod 置空（同源不需要 CORS）
GYM3D_LOG_LEVEL=info

# ── ★ 上服务器前必须显式写的两个键（2026-10-01 补）────────────────────
# 它们在此之前**不在这份模板里**，而代码里的默认值都是「方便本机调试」的那一侧
# ⇒ 照模板配的人**必然**踩：本机来的请求会无条件变成全校区全能力的超级权限。
# 所以这两行不是"可选调优"，是模板的缺口，补上。
#
# 环回放行闸。**代码默认 True**（settings.py:115），命中时 authz.py 直接返回
# builder 级 Principal。服务器上必须显式关掉。
GYM3D_LOOPBACK_BREAKGLASS=1   # ★ 服务器改成 0
# 会话 Cookie 的 Secure 位。走 HTTPS（或反代在 TLS 后面）时置 1；
# 纯 IP:端口 的 http 访问置 1 会让浏览器**不发**这个 cookie ⇒ 登录后立刻又变匿名。
GYM3D_SESSION_COOKIE_SECURE=0 # ★ 走 443/HTTPS 时改成 1
# 校区地形产物目录。默认值落在 `_scratch/` 下（本机构建器的位置），
# 而**服务器上没有 `_scratch`** ⇒ 必须指到解包后的 /opt/gym3d/campus-terrain。
# ★ 不要"把文件复制过去凑默认路径"：那会让同一份 GLB 有两份，"哪份是新的"立刻无解。
# GYM3D_CAMPUS_DIR=/opt/gym3d/campus-terrain

# 过渡期：两个老 stdlib 服务的端口。不设 = 老服务拒绝启动（代码里没有端口默认值）。
# 2026-09-25 已删掉 serve_rooms.py（control.py 还在盘上但别再起）；这两个键等 control.py 一起删。
# 老端口**已并入 8140**（P5，2026-09-25）：分别是 /api/console/* 与 /api/rooms|floors|summary|path。
# 两项只为兼容旧脚本保留；不要再按这两个端口起服务。原文件留档在 _scratch/_retired_20260925/。
GYM3D_LEGACY_CONSOLE_PORT=   # 已并入 8140 → /api/console/*
GYM3D_LEGACY_ROOMS_PORT=     # 已并入 8140 → /api/rooms|floors|summary|path

# ── 数据库（PostgreSQL，库 lihua_twin）────────────────────────────────
LIHUA_DB_HOST=localhost
LIHUA_DB_PORT=5432
LIHUA_DB_USER=gym3d_ro        # 生产用**只读账号**，不要用 postgres 超级用户直连
LIHUA_DB_NAME=lihua_twin
LIHUA_DB_PASSWORD=            # 必填，无默认值。prod 下缺失则拒绝启动
LIHUA_DB_REQUIRED=0           # prod 置 1

# ── 建模作业（仅 GYM3D_COMPUTE=1 时有意义）────────────────────────────
GYM3D_JOB_TIMEOUT_S=7200      # 单阶段超时，到期 terminate（现服务完全没有超时）
GYM3D_JOB_MAX_CONCURRENCY=1
GYM3D_JOB_PERSIST=1           # 日志与状态落盘 data/_jobs/，进程重启后可恢复

# ── 视觉模型（仅本机建模用，服务器留空）──────────────────────────────
DEEPSEEK_API_KEY=

# ── 可选鉴权（留空 = 完全交给 nginx 的 auth_basic）────────────────────
GYM3D_ADMIN_TOKEN=
GYM3D_ROOMS_ADMIN_PORT=   # backend/db/serve_rooms_admin.py（台账后台，会写库，只在本机跑）

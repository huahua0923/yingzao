# gym3d 配置模板 —— 复制成 .env 再填值。.env 已被 .gitignore 排除。
#
# 本文件是**唯一**的配置清单：代码里不出现盘符、端口、口令的字面量。
# 各字段的权威定义见 backend/api/settings.py（Phase 1 落地）。

# ── 路径 ─────────────────────────────────────────────────────────────
# GYM3D_ROOT=               # 留空 = 自动从 backend/api/settings.py 推导仓库根
# GYM3D_DATA_DIR=           # 留空 = <root>/data
GYM3D_DXF_DIR=              # 源 DXF 目录。**仅本机建模需要**；服务器留空
# GYM3D_FRONTEND_DIST=      # 留空 = <root>/frontend/dist

# ── 能力：决定本进程是全功能控制台还是只读服务器 ──────────────────────
# 1 = 本机（可跑管道、可改参数）   0 = 服务器（只发产物，写接口一律 403）
GYM3D_COMPUTE=1
# dev = 允许本地 CORS、返回错误详情；prod = 收紧
GYM3D_ENV=dev

# ── HTTP ────────────────────────────────────────────────────────────
GYM3D_HOST=127.0.0.1         # 服务器上保持 127.0.0.1，只给 nginx 反代，不直接对外
GYM3D_PORT=8130
GYM3D_API_PREFIX=/api
GYM3D_CORS_ORIGINS=http://localhost:5173   # prod 置空（同源不需要 CORS）
GYM3D_LOG_LEVEL=info

# ── 数据库（PostgreSQL，库 lihua_twin）────────────────────────────────
LIHUA_DB_HOST=localhost
LIHUA_DB_PORT=5432
LIHUA_DB_USER=gym3d_ro        # 生产用**只读账号**，不要用 postgres 超级用户直连
LIHUA_DB_NAME=lihua_twin
LIHUA_DB_PASSWORD=            # 必填，无默认值。prod 下缺失则拒绝启动
LIHUA_DB_REQUIRED=0           # prod 置 1

# ── 建模作业（仅 GYM3D_COMPUTE=1 时有意义）────────────────────────────
GYM3D_JOB_TIMEOUT_S=7200      # 单阶段超时，到期 terminate（现服务完全没有超时）
GYM3D_JOB_MAX_CONCURRENCY=1
GYM3D_JOB_PERSIST=1           # 日志与状态落盘 data/_jobs/，进程重启后可恢复

# ── 视觉模型（仅本机建模用，服务器留空）──────────────────────────────
DEEPSEEK_API_KEY=

# ── 可选鉴权（留空 = 完全交给 nginx 的 auth_basic）────────────────────
GYM3D_ADMIN_TOKEN=
